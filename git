[commit]
	gpgsign = true
	verbose = true
	cleanup = scissors
[push]
	autoSetupRemote = true
	followtags = true
[merge]
	conflictstyle = zdiff3
	keepbackup = false
[pull]
	rebase = true
[rebase]
	autosquash = true
	autostash = true
	updateRefs = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	submodule = log
	colorMoved = default
	colorMovedWS = allow-indentation-change
[submodule]
	recurse = true
[status]
	submoduleSummary = true
[branch]
	sort = -committerdate
[tag]
	sort = taggerdate
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
[http]
	postBuffer = 524288000
	sslbackend = openssl
[alias]
	recommit = !git commit -eF $(git rev-parse --git-dir)/COMMIT_EDITMSG
[url "https://github.com/"]
	insteadOf = git@github.com:
